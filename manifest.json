{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/manifest.schema.json",
  "id": "software_verifier_suite",
  "coworker_type": "suite",
  "model_requirement": {
    "model": "default"
  },
  "name": "Software verifier suite",
  "tagline": "Coordinate verification across four specialists",
  "payload_api": "mn.blueprint.v1",
  "version": "4.3.0",
  "description": "Coordinate four specialists to verify functional intent, service integrations, authorization and test quality. Consolidate repeated evidence into distinct verified defects.",
  "workflow": "workflow.json",
  "execution": "execution.json",
  "contracts": "contracts.json",
  "config": "config/default.json",
  "dependencies": "dependencies.json",
  "license": "LICENSE.md",
  "terms": "TERM.md",
  "extensions": {
    "mn.product": {
      "file": "extensions/product.json",
      "required": false
    },
    "mn.storage": {
      "file": "extensions/storage.json",
      "required": true
    },
    "mn.response": {
      "file": "extensions/response.json",
      "required": true
    },
    "mn.context": {
      "file": "extensions/context.json",
      "required": true
    },
    "mn.rag": {
      "file": "extensions/rag.json",
      "required": true
    },
    "mn.llm": {
      "file": "extensions/llm.json",
      "required": true
    },
    "mn.ui": {
      "file": "extensions/ui.json",
      "required": false
    },
    "mn.mcp": {
      "file": "extensions/mcp.json",
      "required": true
    }
  }
}
