{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/extensions/blocks.schema.json",
  "steps": {
    "capture_software_sources": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.intake:capture"
      },
      "inputs": {
        "verification_scope": {
          "$ref": "run_input",
          "path": [
            "verification_scope"
          ]
        }
      },
      "outputs": {
        "result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1
      }
    },
    "extract_software_rules": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.rules:extract"
      },
      "inputs": {
        "previous": {
          "$ref": "upstream",
          "path": [
            "result"
          ],
          "step_id": "capture_software_sources"
        }
      },
      "outputs": {
        "result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1
      }
    },
    "review_software_rules": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.rule_review:review"
      },
      "inputs": {
        "previous": {
          "$ref": "upstream",
          "path": [
            "result"
          ],
          "step_id": "extract_software_rules"
        }
      },
      "outputs": {
        "result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1
      }
    },
    "verify_software_rules": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.verification:verify"
      },
      "inputs": {
        "previous": {
          "$ref": "upstream",
          "path": [
            "result"
          ],
          "step_id": "review_software_rules"
        }
      },
      "outputs": {
        "result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1
      }
    },
    "publish_rules_report": {
      "uses": "mn.blocks.domain_operation@1",
      "hooks": {
        "operation": "domain.reporting:publish"
      },
      "inputs": {
        "previous": {
          "$ref": "upstream",
          "path": [
            "result"
          ],
          "step_id": "verify_software_rules"
        },
        "specialists": {
          "$ref": "upstream",
          "step_id": "coordinate_verification",
          "path": [
            "result"
          ]
        }
      },
      "outputs": {
        "result": {
          "$ref": "flow_output",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1
      }
    },
    "coordinate_verification": {
      "uses": "mn.blocks.bounded_investigation@1",
      "hooks": {
        "initialize": "domain.specialist_workflow:initialize",
        "plan": "domain.specialist_workflow:plan_round",
        "summarize": "domain.specialist_workflow:summarize"
      },
      "inputs": {
        "previous": {
          "$ref": "upstream",
          "step_id": "review_software_rules",
          "path": [
            "result"
          ]
        }
      },
      "limits": {
        "max_calls": 1
      },
      "output_schema": {
        "type": "object",
        "required": [
          "report",
          "approval",
          "capture"
        ]
      }
    }
  }
}
