{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "code_verifier_v1",
  "mode": "static_dag",
  "execution": {
    "strategy": "parallel",
    "max_parallel_steps": 5,
    "supervision": "activity"
  },
  "steps": [
    {
      "id": "capture_software_sources",
      "kind": "source",
      "label": "Capture source and docs",
      "goal": "Capture source and docs with exact source references and explicit limits.",
      "needs": [],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "extract_software_rules",
      "kind": "stage",
      "label": "Create editable rules",
      "goal": "Create editable rules with exact source references and explicit limits.",
      "needs": [
        "capture_software_sources"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "review_software_rules",
      "kind": "stage",
      "label": "Review rules",
      "goal": "Present a titled Markdown rule list for review and editing; wait for approval of the entire saved version in OtterDesk Chat.",
      "needs": [
        "extract_software_rules"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "verify_software_rules",
      "kind": "stage",
      "label": "Verify each rule",
      "goal": "Verify each rule with exact source references and explicit limits.",
      "needs": [
        "review_software_rules"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      }
    },
    {
      "id": "coordinate_verification",
      "kind": "stage",
      "label": "Coordinate specialist checks",
      "goal": "Dispatch relevant verification assignments, preserve attempts and reconcile all mandatory evidence.",
      "needs": [
        "review_software_rules"
      ],
      "control": {
        "retry": {
          "max_attempts": 2
        }
      }
    },
    {
      "id": "publish_rules_report",
      "kind": "sink",
      "label": "Publish combined report",
      "goal": "Merge rule review and four specialist reports into one evidence-backed verdict.",
      "needs": [
        "verify_software_rules",
        "coordinate_verification"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      }
    }
  ],
  "policy": {
    "human": {
      "enabled": true,
      "mode": "approval_required",
      "allowed_decisions": [
        "approve",
        "revise",
        "reject"
      ],
      "default_action": "reject",
      "blocked_actions": [
        "verify_unapproved_rules"
      ],
      "reason": "The supervisor must approve the exact extracted and custom rules before source verification."
    }
  },
  "child_workflows": {
    "coordinate_verification": {
      "planner": "plan_verification_round",
      "templates": {
        "plan_verification_round": {
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": []
          }
        },
        "inspect_functional": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.specialist_workflow:inspect_functional"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "packet",
                  "assignment"
                ]
              },
              "limits": {
                "max_calls": 1
              }
            }
          },
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "packet",
              "assignment"
            ]
          }
        },
        "inspect_security": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.specialist_workflow:inspect_security"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "packet",
                  "assignment"
                ]
              },
              "limits": {
                "max_calls": 1
              }
            }
          },
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "packet",
              "assignment"
            ]
          }
        },
        "inspect_compatibility": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.specialist_workflow:inspect_compatibility"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "packet",
                  "assignment"
                ]
              },
              "limits": {
                "max_calls": 1
              }
            }
          },
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "packet",
              "assignment"
            ]
          }
        },
        "inspect_reliability": {
          "run": {
            "block": {
              "uses": "mn.blocks.domain_operation@1",
              "hooks": {
                "operation": "domain.specialist_workflow:inspect_reliability"
              },
              "input_schema": {
                "type": "object",
                "required": [
                  "packet",
                  "assignment"
                ]
              },
              "limits": {
                "max_calls": 1
              }
            }
          },
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "packet",
              "assignment"
            ]
          }
        }
      },
      "inputs": {
        "seed": [
          "outputs",
          "result"
        ]
      },
      "outputs": {
        "result": [
          "result"
        ]
      },
      "max_rounds": 4,
      "max_steps_per_round": 64
    }
  }
}
