{
  "$schema": "https://mirrorneuron.io/schemas/blueprint/v1/workflow.schema.json",
  "workflow_id": "code_verifier_v1",
  "mode": "static_dag",
  "execution": {
    "strategy": "parallel",
    "max_parallel_steps": 5,
    "supervision": "activity"
  },
  "steps": [
    {
      "id": "admit_verification_scope",
      "kind": "source",
      "label": "Admit verification scope",
      "goal": "Validate the bounded verification request and its pinned evidence before intake.",
      "needs": [],
      "run": {
        "definition": "mn_sdk.integrations.wit_step",
        "with": {
          "agent_id": "admit_scope",
          "fields": {
            "verification_scope": {
              "$ref": "run_input",
              "path": [
                "verification_scope"
              ]
            },
            "assurance_evidence_sha256": {
              "$ref": "run_input",
              "path": [
                "assurance_evidence_sha256"
              ]
            },
            "assurance_basis_sha256": {
              "$ref": "run_input",
              "path": [
                "assurance_basis_sha256"
              ]
            }
          }
        }
      }
    },
    {
      "id": "capture_software_sources",
      "kind": "source",
      "label": "Capture source and docs",
      "goal": "Capture source and docs with exact source references and explicit limits.",
      "needs": [
        "admit_verification_scope"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      },
      "run": {
        "definition": "mn_sdk.integrations.wit_step",
        "with": {
          "agent_id": "run_capture_software_sources",
          "fields": {
            "verification_scope": {
              "$ref": "upstream",
              "step_id": "admit_verification_scope",
              "path": [
                "result",
                "verification_scope"
              ]
            },
            "assurance_evidence_sha256": {
              "$ref": "upstream",
              "step_id": "admit_verification_scope",
              "path": [
                "result",
                "assurance_evidence_sha256"
              ]
            },
            "assurance_basis_sha256": {
              "$ref": "upstream",
              "step_id": "admit_verification_scope",
              "path": [
                "result",
                "assurance_basis_sha256"
              ]
            },
            "collaboration_group_id": {
              "$ref": "run_input",
              "path": [
                "collaboration_group_id"
              ]
            },
            "collaboration_peers": {
              "$ref": "run_input",
              "path": [
                "collaboration_peers"
              ]
            },
            "supervisor_instructions": {
              "$ref": "run_input",
              "path": [
                "supervisor_instructions"
              ]
            }
          }
        }
      }
    },
    {
      "id": "extract_software_rules",
      "kind": "stage",
      "label": "Create editable rules",
      "goal": "Create editable rules with exact source references and explicit limits.",
      "needs": [
        "capture_software_sources"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      },
      "run": {
        "definition": "mn_sdk.integrations.wit_step",
        "with": {
          "agent_id": "run_extract_software_rules",
          "fields": {
            "previous": {
              "$ref": "upstream",
              "path": [
                "result"
              ],
              "step_id": "capture_software_sources"
            }
          }
        }
      }
    },
    {
      "id": "review_software_rules",
      "kind": "stage",
      "label": "Review rules",
      "goal": "Present a titled Markdown rule list for review and editing; wait for approval of the entire saved version in OtterDesk Chat.",
      "needs": [
        "extract_software_rules"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      },
      "run": {
        "definition": "mn_sdk.integrations.wit_step",
        "with": {
          "agent_id": "run_review_software_rules",
          "fields": {
            "previous": {
              "$ref": "upstream",
              "path": [
                "result"
              ],
              "step_id": "extract_software_rules"
            }
          }
        }
      }
    },
    {
      "id": "verify_software_rules",
      "kind": "stage",
      "label": "Verify each rule",
      "goal": "Verify each rule with exact source references and explicit limits.",
      "needs": [
        "review_software_rules"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      },
      "run": {
        "definition": "mn_sdk.integrations.wit_step",
        "with": {
          "agent_id": "run_verify_software_rules",
          "fields": {
            "previous": {
              "$ref": "upstream",
              "path": [
                "result"
              ],
              "step_id": "review_software_rules"
            }
          }
        }
      }
    },
    {
      "id": "coordinate_verification",
      "kind": "stage",
      "label": "Coordinate specialist checks",
      "goal": "Dispatch relevant verification assignments, preserve attempts and reconcile all mandatory evidence.",
      "needs": [
        "review_software_rules"
      ],
      "control": {
        "retry": {
          "max_attempts": 2
        }
      },
      "run": {
        "definition": "mn_sdk.integrations.wit_step",
        "with": {
          "agent_id": "run_coordinate_verification",
          "fields": {
            "previous": {
              "$ref": "upstream",
              "step_id": "review_software_rules",
              "path": [
                "result"
              ]
            }
          }
        }
      }
    },
    {
      "id": "publish_rules_report",
      "kind": "sink",
      "label": "Publish combined report",
      "goal": "Merge rule review and four specialist reports into one evidence-backed verdict.",
      "needs": [
        "verify_software_rules",
        "coordinate_verification"
      ],
      "control": {
        "retry": {
          "max_attempts": 1
        }
      },
      "run": {
        "definition": "mn_sdk.integrations.wit_step",
        "with": {
          "agent_id": "run_publish_rules_report",
          "fields": {
            "previous": {
              "$ref": "upstream",
              "path": [
                "result"
              ],
              "step_id": "verify_software_rules"
            },
            "specialists": {
              "$ref": "upstream",
              "step_id": "coordinate_verification",
              "path": [
                "result"
              ]
            }
          }
        }
      }
    }
  ],
  "policy": {
    "human": {
      "enabled": true,
      "mode": "approval_required",
      "allowed_decisions": [
        "approve",
        "revise",
        "reject"
      ],
      "default_action": "reject",
      "blocked_actions": [
        "verify_unapproved_rules"
      ],
      "reason": "The supervisor must approve the exact extracted and custom rules before source verification."
    }
  },
  "child_workflows": {
    "coordinate_verification": {
      "planner": "plan_verification_round",
      "templates": {
        "plan_verification_round": {
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": []
          },
          "run": {
            "wit": "plan-round"
          }
        },
        "inspect_functional": {
          "run": {
            "wit": "inspect-functional"
          },
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "packet",
              "role"
            ]
          }
        },
        "inspect_security": {
          "run": {
            "wit": "inspect-security"
          },
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "packet",
              "role"
            ]
          }
        },
        "inspect_compatibility": {
          "run": {
            "wit": "inspect-compatibility"
          },
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "packet",
              "role"
            ]
          }
        },
        "inspect_reliability": {
          "run": {
            "wit": "inspect-reliability"
          },
          "control": {
            "retry": {
              "max_attempts": 2
            }
          },
          "input_schema": {
            "type": "object",
            "required": [
              "packet",
              "role"
            ]
          }
        }
      },
      "inputs": {
        "seed": [
          "outputs",
          "result"
        ]
      },
      "outputs": {
        "result": [
          "result"
        ]
      },
      "max_rounds": 4,
      "max_steps_per_round": 1
    }
  }
}
